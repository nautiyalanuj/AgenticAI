# DeepSeek API (OpenAI-compatible)
DEEPSEEK_API_KEY=replace-me
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Tavily web search
TAVILY_API_KEY=replace-me

# LangSmith tracing
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=replace-me
LANGSMITH_PROJECT=travel-assistant

# Local PostgreSQL from docker-compose.yml
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/travel_assistant?sslmode=disable
